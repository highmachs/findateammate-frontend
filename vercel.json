{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",


  "crons": [
    {
      "path": "/api/internal/daily-cleanup",
      "schedule": "0 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
