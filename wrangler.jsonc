{
  "name": "findateammate-ws",
  "main": "party/worker.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "Chat", "class_name": "Chat" },
      { "name": "Notifications", "class_name": "Notifications" },
      { "name": "Global", "class_name": "Global" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Chat", "Notifications", "Global"]
    }
  ],
  "vars": {
    "VERCEL_API_URL": "https://findateammate.online"
  }
}
